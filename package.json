{
  "name": "darshan-borse-site",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "node scripts/seo.mjs && vite build && node scripts/check-css.mjs",
    "build:dev": "vite build --mode development",
    "brand": "python brand/build.py && node brand/share.mjs",
    "preview": "wrangler pages dev dist/client --port 8788",
    "lint": "eslint .",
    "format": "prettier --write src scripts tests",
    "check": "tsc --noEmit -p tsconfig.json && eslint src scripts tests",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify": "npm run check && npm run test && npm run build",
    "deploy": "wrangler pages deploy dist/client --project-name darshan-borse"
  },
  "overrides": {
    "rolldown": "1.2.1"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.18",
    "@tanstack/react-start": "1.168.32",
    "@tanstack/router-plugin": "1.168.23",
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.7.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vite": "8.1.5",
    "vitest": "^5.0.2",
    "wrangler": "^4.141.0"
  }
}
